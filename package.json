{
  "name": "alexandryn-docs",
  "private": true,
  "version": "1.0.0",
  "description": "The documentation site for Alexandryn, a self-hosted digital library.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "sync:openapi": "node scripts/sync-openapi.ts",
    "check:openapi": "node scripts/check-openapi.ts",
    "check:links": "node scripts/check-links.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "starlight-openapi": "^0.26.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "form-data": "4.0.5"
  }
}
